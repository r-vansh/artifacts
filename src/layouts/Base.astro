---
import "../styles/global.css"
import Logo from "../components/icons/Logo.astro"
import Contact from "../components/Contact.astro"
import Garden from "../components/Garden.astro"
import Cord from "../components/Cord.astro"

interface Props {
    title?: string
    description?: string
    image?: string
}

const {
    title,
    description = "art/facts: experiments by Vansh Rastogi, built over time while learning tools, workflows and tricks.",
    image,
} = Astro.props
const fullTitle = title ? `${title} · art/facts` : "art/facts · Vansh Rastogi"
const canonical = new URL(Astro.url.pathname, Astro.site)

---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script is:inline define:vars={{ dev: import.meta.env.DEV }}>
            // The loading animation (src/lib/splash.ts) plays on the first page of a visit, so
            // the veil it plays on has to be up before the first paint. Every load under
            // `npm run dev`; never under reduced motion or in a tab opened in the background.
            try {
                if (
                    matchMedia("(prefers-reduced-motion: no-preference)").matches &&
                    document.visibilityState === "visible" &&
                    (dev || !sessionStorage.getItem("splash"))
                ) {
                    sessionStorage.setItem("splash", "1")
                    document.documentElement.setAttribute("data-splash", "")
                    // Where the pointer is, so the loader's cursor can start there at once
                    addEventListener("pointermove", (e) => (window.splashPointer = { x: e.clientX, y: e.clientY }), { passive: true })
                }
            } catch {}
        </script>
        <slot name="head" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f7f7f8" />
        <script is:inline>
            // Dark mode, if that was the choice (src/lib/theme.ts), before the first paint
            try {
                if (localStorage.getItem("theme") === "dark") {
                    document.documentElement.dataset.theme = "dark"
                    document.querySelector('meta[name="theme-color"]').content = "#101011"
                }
            } catch {}
        </script>
        <link rel="canonical" href={canonical} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/geist-pixel-circle.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="alternate" type="application/rss+xml" title="art/facts" href="/rss.xml" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content="website" />
        {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
        <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    </head>
    <body data-barba="wrapper">
        <div class="splash" aria-hidden="true"></div>
        <header class="top">
            <a href="https://vanshrastogi.me" aria-label="Vansh Rastogi, portfolio" class="mark"><Logo height={32} /></a>
        </header>
        <Cord />
        <slot />
        <Contact />
        <Garden />
    </body>
</html>

<script>
    import "../lib/nav"

    // The loading animation, when the head script picked this page for it. It is a lazy
    // chunk; if it fails to load, the veil goes at once.
    const root = document.documentElement
    if (root.hasAttribute("data-splash"))
        import("../lib/splash").catch(() => {
            root.removeAttribute("data-splash")
            document.dispatchEvent(new Event("splash:done"))
        })
</script>

<style>
    /* The veil the loading animation plays on (src/lib/splash.ts), over everything. Its
       white (the brief asks for pure white) is a layer of its own so it can lift while the
       strokes fade over the page. If the animation never starts, it lifts on its own after
       5 s. */
    .splash {
        display: none;
    }
    :global(html[data-splash]) .splash {
        display: block;
        /* The loader draws its own cursor (the pill); the arrow is gone from the first paint */
        cursor: none;
        position: fixed;
        inset: 0;
        z-index: 100;
        animation: splash-failsafe 0.5s 5s forwards;
    }
    /* The home page's dev-only tuning panel stays out of the loader's way */
    :global(html[data-splash] .tune) {
        display: none;
    }
    .splash[data-live]::before {
        display: none;
    }
    .splash::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--white);
        transition: opacity var(--lift, 0.7s) ease-out;
    }
    .splash[data-lift] {
        pointer-events: none;
    }
    .splash[data-lift]::before {
        opacity: 0;
    }
    .splash :global(canvas) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
    @keyframes splash-failsafe {
        to {
            opacity: 0;
            visibility: hidden;
        }
    }
    /* The logo sits on the left guide line (Figma frame 3203:17832) */
    .top {
        display: flex;
        justify-content: flex-start;
        padding: 24px var(--edge) 0;
    }
    .mark {
        display: inline-flex;
        color: var(--black);
    }
    .mark:hover {
        color: var(--gray-main);
    }
</style>
