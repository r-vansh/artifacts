---
import "../styles/global.css"
import Logo from "../components/icons/Logo.astro"
import Contact from "../components/Contact.astro"

interface Props {
    title?: string
    description?: string
    image?: string
}

const {
    title,
    description = "art/facts: experiments by Vansh Rastogi, built over time while learning tools, workflows and tricks.",
    image,
} = Astro.props
const fullTitle = title ? `${title} · art/facts` : "art/facts · Vansh Rastogi"
const canonical = new URL(Astro.url.pathname, Astro.site)

const nav = [
    { label: "Resume", href: "https://drive.google.com/file/d/1ToBkoytEI-dncMYj2WT-1YDqcAKHq-IR/view?usp=sharing" },
    { label: "Work", href: "https://vanshrastogi.me/#case-study" },
    { label: "X-periments", href: "/" },
    { label: "Contact", href: "https://vanshrastogi.me/#contact" },
    { label: "Colophon", href: "/colophon" },
]
const here = Astro.url.pathname
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f6f6f6" />
        <link rel="canonical" href={canonical} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/geist-pixel-circle.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="alternate" type="application/rss+xml" title="art/facts" href="/rss.xml" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content="website" />
        {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
        <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    </head>
    <body>
        <header class="top">
            <a href="https://vanshrastogi.me" aria-label="Vansh Rastogi, portfolio" class="mark"><Logo height={32} /></a>
        </header>
        <slot />
        <Contact />
        <footer class="bottom wrap">
            <a href="https://vanshrastogi.me" aria-label="Vansh Rastogi, portfolio" class="mark"><Logo height={48} /></a>
            <nav aria-label="Site">
                {
                    nav.map((n) => (
                        <a class="caps" href={n.href} aria-current={n.href === here ? "page" : undefined}>
                            {n.label}
                        </a>
                    ))
                }
            </nav>
        </footer>
    </body>
</html>

<style>
    .top {
        display: flex;
        justify-content: center;
        padding-top: 24px;
    }
    .mark {
        display: inline-flex;
        color: #000;
    }
    .mark:hover {
        color: var(--primary);
    }
    .bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-top: clamp(80px, 11.1vw, 160px);
        border-top: 1px solid var(--gray-200);
        padding-bottom: 0;
    }
    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0 clamp(8px, 1.667vw, 24px);
        padding-top: 3px;
    }
    nav a {
        padding: 8px;
    }
    nav a:hover,
    nav a[aria-current="page"] {
        color: var(--primary);
    }
</style>
