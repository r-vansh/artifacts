---
import { Picture } from "astro:assets"
import { href, ratioOf, type Entry } from "../lib/entries"

interface Props {
    entry: Entry
    number: number
    eager?: boolean
}

const { entry, number, eager = false } = Astro.props
const d = entry.data
const external = d.kind === "external"
---

<article class="card" style={`--ratio: ${ratioOf(entry)}`}>
    <p class="number">{String(number).padStart(3, "0")}</p>
    <a href={href(entry)} {...(external ? { rel: "noopener" } : {})}>
        {
            d.poster ? (
                <Picture
                    src={d.poster}
                    alt={d.posterAlt}
                    formats={["avif", "webp"]}
                    widths={[420, 640, 840, 1260]}
                    sizes="(min-width: 1200px) 20vw, (min-width: 900px) 25vw, (min-width: 600px) 33vw, 50vw"
                    loading={eager ? "eager" : "lazy"}
                    fetchpriority={eager ? "high" : "auto"}
                />
            ) : (
                <div class="fill" style={`aspect-ratio: 1 / var(--ratio); background: ${d.fill}`} />
            )
        }
        <span class="sr-only">{d.title}{external && " (opens another site)"}</span>
    </a>
</article>

<style>
    /* The post's running number above its poster (Figma frame 3180:17526) */
    .number {
        margin: 0 0 8px;
        font-weight: 300;
        font-size: 12px;
        line-height: 1;
        letter-spacing: 0;
        color: var(--gray-900);
    }
    /* The square the poster sits in, Gray/200 while it loads */
    .card a {
        position: relative;
        display: block;
        background: var(--gray-200);
        overflow: hidden;
    }
    .card :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / var(--ratio);
        object-fit: cover;
    }
    .fill {
        width: 100%;
    }
    /* The design shows posters only; the title stays for screen readers */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>
