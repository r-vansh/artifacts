---
import { Picture } from "astro:assets"
import { href, ratioOf, type Entry } from "../lib/entries"

interface Props {
    entry: Entry
    number: number
    eager?: boolean
    /** Column counts for which a crosshair sits at this card's bottom right (see Grid.astro) */
    crosses?: number[]
}

const { entry, number, eager = false, crosses = [] } = Astro.props
const d = entry.data
const external = d.kind === "external"
// A video in the experiment's folder plays over the poster while the pointer is on it
const videos = import.meta.glob<string>("../experiments/*/*.mp4", { query: "?url", import: "default", eager: true })
// A small `preview.mp4` is used when there is one (see README), else any .mp4 in the folder
const mine = Object.entries(videos).filter(([path]) => path.split("/").at(-2) === entry.id)
const video = (mine.find(([path]) => path.endsWith("/preview.mp4")) ?? mine[0])?.[1]
---

<article class="card" style={`--ratio: ${ratioOf(entry)}`}>
    <p class="meta" aria-hidden="true">
        <span class="number">.{String(number).padStart(3, "0")}</span>
        <span class="title">{d.title}</span>
    </p>
    <a href={href(entry)} {...(external ? { rel: "noopener" } : {})}>
        {
            d.poster ? (
                <Picture
                    src={d.poster}
                    alt={d.posterAlt}
                    formats={["avif", "webp"]}
                    widths={[420, 640, 840, 1260]}
                    sizes="(min-width: 1200px) 20vw, (min-width: 900px) 25vw, (min-width: 600px) 33vw, 50vw"
                    loading={eager ? "eager" : "lazy"}
                    fetchpriority={eager ? "high" : "auto"}
                />
            ) : (
                <div class="fill" style={`aspect-ratio: 1 / var(--ratio); background: ${d.fill}`} />
            )
        }
        {video && <video src={video} loop playsinline preload="none" tabindex="-1" aria-hidden="true" />}
        <span class="sr-only">{d.title}{external && " (opens another site)"}</span>
    </a>
    {crosses.map((n) => <span class={`cross n${n}`} aria-hidden="true" />)}
</article>

<style>
    .card {
        position: relative;
    }
    /* The dashed crosshair where four posters meet (Figma node 3208:17894), 38px, centred on
       the middle of the gap: half the column gap to the right of this poster and half the row
       gap (plus the 20px title row of the next one) under it. The column gap is what is left
       of the row's width after the posters, so it also holds past 1440 where it grows. Shown
       only for the number of columns the grid has at this width */
    .cross {
        --n: 5;
        --cs: 38px; /* its size */
        --ct: 20px; /* the next poster's title row, which the centre allows for */
        display: none;
        position: absolute;
        left: calc(100% + (100cqw - var(--n) * 100%) / (2 * (var(--n) - 1)) - var(--cs) / 2);
        top: calc(100% + (var(--row-gap) + var(--ct)) / 2 - var(--cs) / 2);
        width: var(--cs);
        height: var(--cs);
        background: var(--gray-200);
        mask: url("/crosshair.svg") no-repeat center / var(--cs) var(--cs);
        pointer-events: none;
    }
    /* Figma's Gray/900 (#2a2a2d) in dark mode (Vansh, 2026-11-08): the dark theme's tokens are flipped,
       so that value is --gray-100 there */
    :global(html[data-theme="dark"]) .cross {
        background: var(--gray-100);
    }
    .cross.n5 {
        display: block;
    }
    @media (max-width: 1199px) {
        .cross.n5 {
            display: none;
        }
        .cross.n4 {
            --n: 4;
            display: block;
        }
    }
    /* A touch tablet held sideways: three across (Grid.astro) */
    @media (max-width: 1199px) and (any-pointer: coarse) {
        .cross.n4 {
            display: none;
        }
        .cross.n3 {
            --n: 3;
            display: block;
        }
    }
    @media (max-width: 899px) {
        .cross.n4 {
            display: none;
        }
        .cross.n3 {
            --n: 3;
            display: block;
        }
    }
    @media (max-width: 599px) {
        .cross.n3 {
            display: none;
        }
        .cross.n2 {
            --n: 2;
            --cs: 32px; /* the frame has 24px; Vansh made it larger, 2026-11-07 */
            --ct: 0px; /* on a phone the frame centres it between the two cards */
            display: block;
        }
    }
    /* The post's running number and title above its poster (Figma frame 3203:17832): Geist
       Pixel Circle 12px in Gray/900, number left, title right, 8px above the poster */
    .meta {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        margin: 0 0 8px;
        font-family: var(--pixel);
        font-size: 12px;
        line-height: 1;
        letter-spacing: -0.03em;
        text-transform: lowercase;
        white-space: nowrap;
        color: var(--gray-900);
        /* The bulge under the pointer (src/lib/dock.ts sets --t and --w): the row is part of
           the poster's tile, the same transform round the same point (the poster's centre:
           8px under the row, then half the poster) */
        transform: var(--t, none);
        transform-origin: 50% calc(100% + 8px + var(--w, 0px) / 2);
    }
    @media (max-width: 599px) {
        .meta {
            font-size: 11px;
        }
    }
    .title {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    /* The square the poster sits in, Gray/200 while it loads */
    .card a {
        position: relative;
        display: block;
        background: var(--gray-200);
        overflow: hidden;
        transform: var(--t, none);
    }
    /* Dark (Figma 3273:17727): the loading square is Gray/100 and the row Gray/800, which is
       not what turning the ramp over gives (Gray/200, Gray/900) */
    :global(html[data-theme="dark"]) .card a {
        background: var(--gray-100);
    }
    :global(html[data-theme="dark"]) .meta {
        color: var(--gray-800);
    }
    /* Shade as the tile turns away on the bulge: black at --shade */
    .card a::after {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--black);
        opacity: var(--shade, 0);
        pointer-events: none;
    }
    .card :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / var(--ratio);
        object-fit: cover;
    }
    .fill {
        width: 100%;
    }
    /* The hover video (with sound), over the poster; shown once it plays (the script below) */
    video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.2s;
        pointer-events: none;
    }
    video.on {
        opacity: 1;
    }
    /* The design shows posters only; the title stays for screen readers */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>

<script>
    // Hover only (a mouse): the video's file is fetched on the first hover, and it starts over each time.
    // The sound fades in over 0.8 s and out over 0.4 s (a short rAF tween, no library)
    if (matchMedia("(hover: hover)").matches) {
        const LEVEL = 0.6
        let wait = 0
        const fades = new WeakMap<HTMLVideoElement, number>()
        const fade = (v: HTMLVideoElement, to: number, ms: number, done?: () => void) => {
            cancelAnimationFrame(fades.get(v) ?? 0)
            const from = v.volume
            const t0 = performance.now()
            const tick = (now: number) => {
                const k = Math.min(1, (now - t0) / ms)
                v.volume = from + (to - from) * k
                if (k < 1) fades.set(v, requestAnimationFrame(tick))
                else done?.()
            }
            fades.set(v, requestAnimationFrame(tick))
        }
        const cardOf = (t: EventTarget | null) => (t as HTMLElement | null)?.closest?.(".card") ?? null
        // A video that had to start muted, and the card it is on: the next click or key press anywhere
        // is a gesture the browser accepts, so the sound comes on then, without a second hover
        let silenced: HTMLVideoElement | null = null
        const unlock = () => {
            const v = silenced
            silenced = null
            if (!v || v.paused || !v.classList.contains("on")) return
            v.muted = false
            v.volume = 0
            fade(v, LEVEL, 800)
        }
        addEventListener("pointerdown", unlock, true)
        addEventListener("keydown", unlock, true)
        const start = (v: HTMLVideoElement, retried = false) => {
            // A fade-out still running from the last time must not pause this start
            cancelAnimationFrame(fades.get(v) ?? 0)
            v.currentTime = 0
            v.volume = 0
            v.muted = false
            v.play().then(
                () => {
                    v.classList.add("on")
                    silenced = null
                    fade(v, LEVEL, 800)
                },
                (err: DOMException) => {
                    // Only a refusal of sound (NotAllowedError) is worth falling back on; any other
                    // failure is not (a pause that came in the way is tried once more)
                    if (err?.name === "AbortError" && !retried) return void setTimeout(() => start(v, true), 120)
                    if (err?.name !== "NotAllowedError") return
                    v.muted = true
                    v.play().then(() => {
                        v.classList.add("on")
                        silenced = v
                    }, () => {})
                },
            )
        }
        document.addEventListener("pointerover", (e) => {
            const card = cardOf(e.target)
            // Moving between the card's own children is not coming in
            if (!card || card.contains((e as PointerEvent).relatedTarget as Node | null)) return
            const v = card.querySelector("video")
            if (!v) return
            clearTimeout(wait)
            // A short pause first, so sweeping the pointer across the grid starts no downloads
            wait = window.setTimeout(() => start(v), 150)
        })
        document.addEventListener("pointerout", (e) => {
            const card = cardOf(e.target)
            if (!card || card.contains((e as PointerEvent).relatedTarget as Node | null)) return
            clearTimeout(wait)
            const v = card.querySelector("video")
            if (!v) return
            v.classList.remove("on")
            fade(v, 0, 400, () => v.pause())
        })
    }
</script>
