---
// The cards, featured then newest first, in a plain grid of square posters with each post's
// number above it (Figma frame 3180:17526: five across the content width, 80px between
// columns, 160px between rows at 1440 wide). Fewer columns on smaller screens: 4 under
// 1200px, 3 under 900px, 2 under 600px, the gaps scaling down with the page.
import Card from "./Card.astro"
import type { Entry } from "../lib/entries"

interface Props {
    items: { entry: Entry; number: number }[]
}

const { items } = Astro.props
---

<div class="grid">
    {items.map(({ entry, number }, i) => <Card entry={entry} number={number} eager={i < 5} />)}
</div>

<script>
    import "../lib/overlay"
</script>

<style>
    /* A post opens in a layer over the grid (src/lib/overlay.ts) */
    :global(.overlay) {
        position: fixed;
        inset: 0;
        z-index: 50;
        overflow-y: auto;
        overscroll-behavior: contain;
        background: var(--white);
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.25s ease-out, transform 0.25s ease-out;
        outline: none;
    }
    :global(.overlay.on) {
        opacity: 1;
        transform: none;
    }
    :global(.overlay.out) {
        opacity: 0;
    }
    @media (prefers-reduced-motion: reduce) {
        :global(.overlay) {
            transition: none;
            transform: none;
        }
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        align-items: start;
        /* 80px and 160px at 1440 wide */
        column-gap: clamp(24px, 5.556vw, 80px);
        row-gap: clamp(48px, 11.111vw, 160px);
    }
    @media (max-width: 1199px) {
        .grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }
    @media (max-width: 899px) {
        .grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    @media (max-width: 599px) {
        .grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
