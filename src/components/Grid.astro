---
// The cards, featured then newest first, in a plain grid of square posters with each post's
// number and title above it (Figma frame 3203:17832: five across the content width, 240px
// between rows at 1440 wide). Never more than five a row; Vansh asked for smaller posts
// (2026-10-31), so the column gap is 128px at 1440 instead of the frame's 80px, which makes
// the posters 160px instead of 198px while the row still spans guide to guide. Fewer
// columns on smaller screens: 4 under 1200px, 3 under 900px, 2 under 600px, the gaps scaling
// down with the page. Past 1440 wide the posters stay 160px and the gaps between them grow.
import Card from "./Card.astro"
import type { Entry } from "../lib/entries"

interface Props {
    items: { entry: Entry; number: number }[]
}

const { items } = Astro.props
// A crosshair sits where four posters meet (Figma node 3208:17894): at the bottom right of a
// card that has a neighbour to its right, one below and one below-right, for each possible
// number of columns
const COLUMNS = [5, 4, 3, 2]
const crosses = (i: number) => COLUMNS.filter((n) => i % n < n - 1 && i + n + 1 < items.length)
---

<div class="grid">
    {items.map(({ entry, number }, i) => <Card entry={entry} number={number} eager={i < 5} crosses={crosses(i)} />)}
</div>

<script>
    import "../lib/dock"
    // Posts opening as an overlay (src/lib/overlay.ts) load lazily, like Barba: on idle or the
    // first sign of interest. A click before it is ready opens the post as a page.
    let overlay: Promise<unknown> | undefined
    const load = () => (overlay ??= import("../lib/overlay").catch(() => (overlay = undefined)))
    for (const ev of ["pointerover", "pointerdown", "touchstart", "focusin"]) addEventListener(ev, load, { once: true, passive: true })
    if ("requestIdleCallback" in window) requestIdleCallback(load, { timeout: 3000 })
    else setTimeout(load, 2000)
    // The dock's tuning panel, only under `npm run dev`
    if (import.meta.env.DEV) import("../lib/dock-tune")
    // ...and the post opening's (the bulge, the handover, the particles)
    if (import.meta.env.DEV) import("../lib/morph-tune")
</script>

<style>
    /* A post opens over the grid (src/lib/overlay.ts): the layer is a frosted scrim (a click
       on it closes the post) and the post's <main> holds its card (src/pages/[slug].astro,
       Figma 3235:42578), centred; the card sizes itself (955 x 805, at most 90vh) */
    :global(.overlay) {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        opacity: 0;
        outline: none;
    }
    /* The scrim (Figma frame 3235:40632, node 3235:40703): a light frosted glass, 16px blur
       under rgb(232 232 232) at 60%. That grey is not a token; it is mixed from the two it sits
       between, Gray/100 (237) and Gray/200 (221), 70/30. The crosshair marks over it are an
       <svg> overlay.ts adds (.marks, below). On its own layer, so it can fade in and out
       without fading the card with it (overlay.ts animates this, not the whole layer: the
       card came in see-through while the scrim faded up, Vansh, 2026-11-05) */
    :global(.overlay::before) {
        content: "";
        position: absolute;
        inset: 0;
        background: color-mix(in srgb, color-mix(in srgb, var(--gray-100) 70%, var(--gray-200)) 60%, transparent);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }
    /* Dark (Figma 3274:17839): Gray/100 at 60% */
    :global(html[data-theme="dark"] .overlay::before) {
        background: color-mix(in srgb, var(--gray-100) 60%, transparent);
    }
    :global(.overlay.on) {
        opacity: 1;
    }
    :global(.overlay.out) {
        opacity: 0;
    }
    /* The scrim's crosshair marks (Figma 3235:42694): public/overlay-mark.svg at 40px, 100px
       apart (every 140px) from the window's top left corner; under the panel, not clickable */
    :global(.overlay > .marks) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }
    :global(.overlay > main.wrap) {
        position: relative;
        z-index: 1;
        flex: none;
        width: calc(100% - 2 * var(--edge));
        padding: 0;
    }
    /* The card expanded to the full window (src/lib/overlay.ts) */
    :global(.overlay.full > main.wrap) {
        width: 100%;
    }
    @media (prefers-reduced-motion: reduce) {
        :global(.overlay),
        :global(.overlay > main.wrap) {
            transition: none;
            transform: none;
        }
    }
    .grid {
        /* Cards size the crosshairs' offsets from the row's width (cqw), and the row gap */
        container-type: inline-size;
        /* The dock's z-indexes (src/lib/dock.ts) stay inside the grid, under the loader and the overlay */
        isolation: isolate;
        --row-gap: clamp(48px, 16.667vw, 240px);
        display: grid;
        /* Posters stop growing at 160px (their size at 1440); on wider windows the row stays
           guide to guide and the gaps between the posters grow instead */
        grid-template-columns: repeat(5, minmax(0, 160px));
        justify-content: space-between;
        align-items: start;
        /* 128px and 240px at 1440 wide */
        column-gap: clamp(24px, 8.889vw, 128px);
        row-gap: var(--row-gap);
    }
    @media (max-width: 1199px) {
        .grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }
    @media (max-width: 899px) {
        .grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    /* A phone (Figma 3291:18544): two posters a third of the row wide each, the rest between them
       (125px and 120px at 402 wide), and 120px between the rows */
    @media (max-width: 599px) {
        .grid {
            grid-template-columns: repeat(2, minmax(0, 33.78%));
            --row-gap: min(29.85vw, 160px);
        }
    }
</style>
