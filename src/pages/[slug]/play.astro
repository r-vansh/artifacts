---
// Stage only, no site chrome: for fullscreen and for embedding in the portfolio
import "../../styles/global.css"
import Stage from "../../components/Stage.astro"
import { getEntries } from "../../lib/entries"

export async function getStaticPaths() {
    const items = await getEntries()
    return items
        .filter(({ entry }) => entry.data.kind === "interactive")
        .map(({ entry }) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{entry.data.title} • ART/FACTS</title>
        <link rel="canonical" href={new URL(`/${entry.id}`, Astro.site)} />
        <link rel="icon" href="/favicon-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
        <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <style is:global>
            body::before,
            body::after {
                display: none;
            }
        </style>
    </head>
    <body>
        <Stage entry={entry} full />
    </body>
</html>
