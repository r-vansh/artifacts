---
import { Picture, getImage } from "astro:assets"
import { render } from "astro:content"
import Base from "../layouts/Base.astro"
import Stage from "../components/Stage.astro"
import { getEntries, ratioOf } from "../lib/entries"

export async function getStaticPaths() {
    const items = await getEntries()
    return items
        .filter(({ entry }) => entry.data.kind !== "external")
        .map(({ entry }) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const d = entry.data
const { Content } = await render(entry)
const og = d.poster ? await getImage({ src: d.poster, width: 1200, format: "jpeg" }) : undefined
---

<Base title={d.title} description={d.summary} image={og?.src}>
    <main class="wrap" data-barba="container" data-barba-namespace="entry">
        <section class="hero">
            <div class="info">
                <a class="back" href="/">
                    <svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true"><path d="M5 1 2 4l3 3" fill="none" stroke="currentColor" /></svg>
                    back
                </a>
                <div class="title">
                    <h1>{d.title}</h1>
                    <p class="summary">{d.summary}</p>
                    <p class="tags">
                        {d.tags.map((t) => <a href={`/tags/${t}`}>{t}</a>)}
                        {d.sound && <span>sound on tap</span>}
                    </p>
                </div>
                <div class="body">
                    <Content />
                </div>
                <p class="links">
                    {d.kind === "interactive" && <a href={`/${entry.id}/play`}>fullscreen</a>}
                    {d.source && <a href={d.source}>source</a>}
                    {d.inPortfolio && <a href={d.inPortfolio}>on vanshrastogi.me</a>}
                </p>
            </div>
            <div class="media" style={`--ratio: ${ratioOf(entry)}`}>
                {
                    d.kind === "interactive" ? (
                        <Stage entry={entry} />
                    ) : d.poster ? (
                        <Picture src={d.poster} alt={d.posterAlt} formats={["avif", "webp"]} widths={[720, 1080, 1600]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" fetchpriority="high" />
                    ) : (
                        <div class="fill" style={`background: ${d.fill}`} />
                    )
                }
                {
                    d.gallery.map((g) =>
                        g.image ? (
                            <Picture src={g.image} alt={g.alt} formats={["avif", "webp"]} widths={[720, 1080, 1600]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" />
                        ) : (
                            <div class="fill" style={`aspect-ratio: 1 / ${g.ratio}; background: ${g.fill}`} />
                        )
                    )
                }
            </div>
        </section>
    </main>
</Base>

<style>
    main {
        padding-top: clamp(32px, 5.556vw, 80px);
    }
    /* Two halves: the text on the left, the stage on the right (648 + 648 at 1440) */
    .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 16px;
        align-items: start;
    }
    /* The text stays in view while the images on the right scroll past */
    .info {
        position: sticky;
        top: 24px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
    }
    .back {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px;
        background: var(--gray-100);
        color: var(--gray-500);
        font-family: var(--pixel);
        font-size: 14px;
        line-height: 1;
        text-transform: lowercase;
    }
    .back:hover {
        color: var(--primary);
    }
    .title {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 400;
        line-height: 1;
    }
    .summary {
        margin: 0;
        font-weight: 300;
        line-height: 1;
        color: var(--gray-500);
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin: 0;
        padding-top: 16px;
    }
    .tags a,
    .tags span {
        padding: 4px;
        border: 1px solid var(--gray-500);
        color: var(--gray-500);
        font-family: var(--pixel);
        font-size: 14px;
        line-height: 1;
        text-transform: lowercase;
    }
    .tags a:hover {
        color: var(--primary);
        border-color: var(--primary);
    }
    .body {
        max-width: 480px;
        font-weight: 300;
        line-height: 1.4;
        color: var(--gray-500);
    }
    .body :global(strong) {
        font-weight: 400;
        color: var(--gray-main);
    }
    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        margin: 0;
        font-family: var(--pixel);
        font-size: 14px;
        text-transform: lowercase;
    }
    .links a {
        color: var(--gray-500);
    }
    .links a:hover {
        color: var(--primary);
    }
    /* The first block has the same proportions as the card on the main page; more media stacks under it */
    .media {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
    }
    .media :global(img),
    .media .fill {
        display: block;
        width: 100%;
        height: auto;
        background: var(--gray-100);
    }
    .media :global(.stage) {
        height: auto;
        min-height: 0;
        aspect-ratio: 1 / var(--ratio);
        border: 0;
    }
    .media > :global(img:first-child),
    .media > .fill:first-child {
        aspect-ratio: 1 / var(--ratio);
        object-fit: cover;
    }
    @media (max-width: 899px) {
        .hero {
            grid-template-columns: 1fr;
        }
        .info {
            position: static;
        }
    }
</style>
