---
import { Picture, getImage } from "astro:assets"
import Base from "../layouts/Base.astro"
import Stage from "../components/Stage.astro"
import { getEntries } from "../lib/entries"

export async function getStaticPaths() {
    const items = await getEntries()
    return items
        .filter(({ entry }) => entry.data.kind !== "external")
        .map(({ entry }) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
// Gallery videos: files in the entry's folder, by name
const mp4s = import.meta.glob<string>("../experiments/*/*.mp4", { query: "?url", import: "default", eager: true })
const mp4 = (name: string) => Object.entries(mp4s).find(([p]) => p.endsWith(`/${entry.id}/${name.replace(/^\.\//, "")}`))?.[1]
const d = entry.data
const og = d.poster ? await getImage({ src: d.poster, width: 1200, format: "jpeg" }) : undefined
// "open": the experiment on its own (the fullscreen stage), or where it lives on the portfolio
// An interactive entry with its own live page (url) opens that instead of /play
const open = d.kind === "interactive" ? (d.url ?? `/${entry.id}/play`) : d.inPortfolio
// Previous and next post in the grid's order, round the ends (the first one's previous is the
// last, the last one's next is the first); only posts that have a page of their own
const pages = (await getEntries()).filter(({ entry: e }) => e.data.kind !== "external").map(({ entry: e }) => e.id)
const at = pages.indexOf(entry.id)
const steps = pages.length > 1 ? { prev: pages[(at - 1 + pages.length) % pages.length], next: pages[(at + 1) % pages.length] } : undefined
---

<Base title={d.title} description={d.summary} image={og?.src}>
    <script is:inline slot="head">
        // A reload of an open post goes back to the grid, closed (Vansh, 2026-11-07); a link or
        // a typed address still opens the page
        try {
            if (performance.getEntriesByType("navigation")[0].type === "reload") location.replace("/")
        } catch {}
    </script>
    <main class="wrap" data-barba="container" data-barba-namespace="entry">
        <!-- The post card (Figma 3235:42578): a white card with dashed guides 40px in from each
             edge, the text on the left and the media on the right, which scrolls on its own -->
        <!-- data-ripple: a ripple runs across the card when it is expanded (overlay.ts); on
             test-11 only for now, to try it -->
        <article class="post" data-ripple={entry.id === "test-11" ? "" : undefined}>
            <a class="corner expand" href={`/${entry.id}`} aria-label="Expand"><i class="icon" /></a>
            <a class="corner back" href="/" aria-label="Close"><i class="icon" /></a>
            <div class="inner">
                <div class="info">
                    <div class="title">
                        <h1>{d.title}</h1>
                        <p class="summary">{d.summary}</p>
                        <p class="tags">{d.tags.map((t) => <span>{t}</span>)}</p>
                    </div>
                    {
                        (steps || open || d.source) && (
                            <p class="links">
                                {steps && (
                                    <>
                                        <a class="chip step" href={`/${steps.prev}`} data-step="prev" aria-label="Previous post">
                                            <i class="icon prev" />
                                        </a>
                                        <a class="chip step" href={`/${steps.next}`} data-step="next" aria-label="Next post">
                                            <i class="icon next" />
                                        </a>
                                    </>
                                )}
                                {open && (
                                    <a class="chip" href={open} target="_blank" rel="noopener">
                                        open
                                        <i class="icon redirect" />
                                    </a>
                                )}
                                {d.source && (
                                    <a class="chip" href={d.source}>
                                        <i class="icon github"><b class="eye" /><b class="eye right" /></i>
                                        github
                                    </a>
                                )}
                            </p>
                        )
                    }
                </div>
                <div class="media">
                    {
                        d.kind === "interactive" ? (
                            <Stage entry={entry} />
                        ) : d.poster ? (
                            <Picture src={d.poster} alt={d.posterAlt} formats={["avif", "webp"]} widths={[720, 1080, 1600]} sizes="880px" loading="eager" fetchpriority="high" />
                        ) : (
                            <div class="fill" style={`background: ${d.fill}`} />
                        )
                    }
                    {
                        d.gallery.map((g) =>
                            g.video ? (
                                <div class="clip">
                                    <video src={mp4(g.video)} loop playsinline preload="metadata" aria-label={g.alt || undefined} style={`aspect-ratio: 1 / ${g.ratio}`} />
                                    <button class="chip step mute" type="button" aria-label="Mute" aria-pressed="false"><i class="icon" /></button>
                                </div>
                            ) : g.image ? (
                                <Picture src={g.image} alt={g.alt} formats={["avif", "webp"]} widths={[720, 1080, 1600]} sizes="880px" loading="lazy" />
                            ) : (
                                <div class="fill" style={`aspect-ratio: 1 / ${g.ratio}; background: ${g.fill}`} />
                            )
                        )
                    }
                </div>
                {
                    steps && (
                        <nav class="steps" aria-label="Posts">
                            <a class="chip step" href={`/${steps.prev}`} data-step="prev" aria-label="Previous post">
                                <i class="icon prev" />
                            </a>
                            <a class="chip step" href={`/${steps.next}`} data-step="next" aria-label="Next post">
                                <i class="icon next" />
                            </a>
                        </nav>
                    )
                }
            </div>
            <i class="band top" aria-hidden="true"></i>
            <i class="band bottom" aria-hidden="true"></i>
            <b class="mini" aria-hidden="true">{d.title}</b>
        </article>
    </main>
</Base>

<style>
    main {
        display: flex;
        justify-content: center;
        padding-top: clamp(32px, 5.556vw, 80px);
        padding-bottom: clamp(32px, 5.556vw, 80px);
    }
    /* 1280 x 800 in the design (Figma 3236:43212): always 16:10, as large as that, never wider
       than its container or taller than 90% of the window */
    .post {
        --frame: 40px;
        --paper: var(--white);
        position: relative;
        box-sizing: border-box;
        width: min(1280px, 100%, 90vh * 1.6);
        aspect-ratio: 16 / 10;
        border: 1px solid var(--gray-100);
        box-shadow: 0 4px 72px color-mix(in srgb, var(--black) 6%, transparent);
        /* Card <-> full window: the edge and its shadow fade with the morph (overlay.ts) */
        transition:
            border-color 0.7s cubic-bezier(0.16, 1, 0.3, 1),
            box-shadow 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        background: var(--paper);
        /* The pseudo-elements' guides go under the content (z-index -1) and over this background */
        isolation: isolate;
    }
    /* The dashed guides, edge to edge, 40px in from each side: real 1px dashed borders, so they
       are exactly the page's own lines (Chrome's dashes, fitted to the length; the same --line).
       The bottom guide is the frame's last row, so the bottom band, which starts just under the
       frame, never covers it; the right guide is just outside the frame's last column, so the media
       column (which fills that column) never covers it */
    .post::before,
    .post::after {
        content: "";
        position: absolute;
        z-index: -1;
        pointer-events: none;
    }
    .post::before {
        left: 0;
        right: 0;
        top: var(--frame);
        bottom: calc(var(--frame) - 1px);
        border-block: 1px dashed var(--line);
    }
    .post::after {
        top: 0;
        bottom: 0;
        left: var(--frame);
        right: calc(var(--frame) - 2px);
        border-inline: 1px dashed var(--line);
    }
    /* Dark (Figma 3274:18283): the card is Gray/Main of the light page (Gray/50 here, not the
       turned-over white, which is black), with a deeper shadow, the title Gray/900, the summary
       Gray/500, the tags Gray/800 of the Figma file (Gray/200 here) and the chips' text Gray/800: not what turning the ramp over
       gives for each */
    :global(html[data-theme="dark"]) .post {
        --paper: var(--gray-50);
        box-shadow: 0 4px 72px color-mix(in srgb, var(--white) 25%, transparent);
    }
    :global(html[data-theme="dark"]) h1 {
        color: var(--gray-900);
    }
    :global(html[data-theme="dark"]) .summary {
        color: var(--gray-500);
    }
    :global(html[data-theme="dark"]) .tags {
        color: var(--gray-200);
    }
    :global(html[data-theme="dark"]) .chip {
        color: var(--gray-800);
    }
    :global(html[data-theme="dark"]) .chip:hover {
        color: var(--gray-main);
    }
    /* Expand (top left, overlay only) and close (top right), 16px, 12px from the corner */
    .corner {
        position: absolute;
        z-index: 2;
        top: 12px;
        display: grid;
        place-items: center;
        width: 16px;
        height: 16px;
        color: var(--gray-500);
    }
    /* The icons (public/icons, from the portfolio's Icons folder): one-colour pixel art used
       as masks, so they take the text colour (Gray/500, darker on hover) */
    .icon {
        display: block;
        width: 16px;
        height: 16px;
        background: currentColor;
        mask: var(--src) center / contain no-repeat;
    }
    .expand .icon {
        --src: url("/icons/expand.svg");
    }
    .back .icon {
        --src: url("/icons/close.svg");
    }
    /* Previous / next (Figma 3236:43212): 14px chevrons in a chip with 4px round it */
    .icon.prev,
    .icon.next {
        width: 14px;
        height: 14px;
    }
    .icon.prev {
        --src: url("/icons/prev.svg");
    }
    .icon.next {
        --src: url("/icons/next.svg");
    }
    .chip.step {
        padding: 4px;
    }
    /* The chevrons at the end of the post: a phone only (it has them at the top on a desktop) */
    .steps {
        display: none;
    }
    /* The title as it is once the card has scrolled, in the top strip (a phone only, below) */
    .mini {
        display: none;
        font-weight: 400;
        letter-spacing: -0.03em;
        color: var(--gray-main);
    }
    :global(html[data-theme="dark"]) .mini {
        color: var(--gray-900);
    }
    .icon.redirect {
        --src: url("/icons/redirect.svg");
        width: 10px;
        height: 10px;
    }
    .corner:hover {
        color: var(--gray-main);
    }
    .expand {
        left: 12px;
        display: none;
    }
    :global(.overlay) .expand {
        display: grid;
    }
    .back {
        right: 12px;
    }
    .inner {
        position: absolute;
        inset: var(--frame);
        display: grid;
        /* The media column is 880 of the 1200 inside the frame, starting at 320 */
        grid-template-columns: minmax(0, 1fr) 73.333%;
        column-gap: var(--frame);
    }
    .info {
        display: flex;
        flex-direction: column;
        min-height: 0;
    }
    .title {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--gray-main);
    }
    .summary {
        margin: 0;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.25;
        letter-spacing: -0.03em;
        color: var(--gray-900);
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 12px;
        margin: 0;
        padding-top: 16px;
        font-family: var(--pixel);
        font-size: 14px;
        line-height: 1;
        letter-spacing: -0.03em;
        text-transform: lowercase;
        color: var(--gray-500);
    }
    /* Only what the Figma card shows: title, summary, tags (plain text), then the links at
       the bottom of the column */
    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: auto 0 0;
        padding-top: 16px;
    }
    .chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        background: var(--gray-100);
        font-size: 14px;
        line-height: 1;
        letter-spacing: -0.03em;
        text-transform: lowercase;
        color: var(--gray-500);
    }
    .chip:hover {
        color: var(--gray-main);
    }
    /* Grey with two white eyes: the whole shape (eyes included) as a mask in the text colour,
       so it darkens on hover like the others, and the eyes laid back over it in white, where
       the file has them (x 2.167 and 7.792, y 2.14, 0.666 x 0.721 of 11 x 10) */
    .icon.github {
        --src: url("/icons/github.svg");
        position: relative;
        width: 11px;
        height: 10px;
    }
    .eye {
        position: absolute;
        left: 19.7%;
        top: 21.4%;
        width: 6.05%;
        height: 7.21%;
        background: var(--white);
    }
    .eye.right {
        left: 70.84%;
    }
    /* The media stack scrolls on its own. Its scroll area runs into the 40px margins above and
       below the frame (padded by them, so at rest it starts and ends on the guides), so what
       scrolls past slides under the frosted bands there (Figma 3243:43542) */
    .media {
        display: flex;
        flex-direction: column;
        gap: 24px;
        min-height: 0;
        margin-block: calc(-1 * var(--frame));
        padding-block: var(--frame);
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: none;
    }
    /* The bands over the top and bottom margins, from the left guide to the card's edge:
       white at 85% over a 20px blur. Over the media, under the corner icons */
    .band {
        position: absolute;
        z-index: 1;
        /* Between the left and right guides, which stay visible the card's full height
           (nothing scrolls outside them) */
        left: calc(var(--frame) + 1px);
        right: var(--frame);
        height: var(--frame);
        background: color-mix(in srgb, var(--paper) 85%, transparent);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        pointer-events: none;
    }
    .band.top {
        top: 0;
    }
    /* One pixel short of the margin: the bottom guide is the frame's last row, and a band over it
       (frosted at 85%) hid it everywhere between the side guides */
    .band.bottom {
        bottom: 0;
        height: calc(var(--frame) - 1px);
    }
    .media::-webkit-scrollbar {
        display: none;
    }
    .media :global(img),
    .media video,
    .media .clip,
    .media .fill {
        display: block;
        flex: none;
        width: 100%;
        height: auto;
        background: var(--gray-100);
    }
    /* A gallery video: plays by itself, with sound, no native controls; just a mute chip in its corner */
    .clip {
        position: relative;
        background: none;
    }
    .clip video {
        display: block;
        width: 100%;
        height: auto;
    }
    .mute {
        position: absolute;
        top: 12px;
        right: 12px;
        border: 0;
        cursor: var(--cursor-hand);
    }
    .mute .icon {
        --src: url("/icons/sound.svg");
    }
    .mute[aria-pressed="true"] .icon {
        --src: url("/icons/muted.svg");
    }
    /* The first block is 880 x 560 in the design (11:7), whatever the poster's own shape */
    .media :global(.stage) {
        flex: none;
        height: auto;
        min-height: 0;
        aspect-ratio: 880 / 560;
        border: 0;
    }
    .media > :global(img:first-child),
    .media > .fill:first-child {
        aspect-ratio: 880 / 560;
        object-fit: cover;
    }
    /* Expanded in the overlay (the expand corner, src/lib/overlay.ts): edge to edge, and only
       the media grows. The text column keeps the width it had in the card (--info-w, set by
       overlay.ts), the media column takes the rest. 100%, not 100vw: the overlay's width
       leaves out the page's scrollbar */
    :global(.overlay.full) .post {
        width: 100%;
        height: 100vh;
        max-height: none;
        aspect-ratio: auto;
        border-color: transparent;
        box-shadow: none;
    }
    :global(.overlay.full) .inner {
        grid-template-columns: var(--info-w, 280px) minmax(0, 1fr);
    }
    /* Narrow: one column, the whole card scrolls (text, then media) */
    @media (max-width: 899px) {
        .post {
            width: 100%;
            aspect-ratio: auto;
            height: auto;
            max-height: 90vh;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: none;
        }
        .post::-webkit-scrollbar {
            display: none;
        }
        .inner {
            position: relative;
            inset: auto;
            margin: var(--frame);
            grid-template-columns: 1fr;
            row-gap: var(--frame);
        }
        .media {
            overflow: visible;
            margin-block: 0;
            padding-block: 0;
        }
        /* The whole card scrolls here, so there is no margin for the media to pass under */
        .band {
            display: none;
        }
    }
    /* A phone, and a tablet held upright (up to 899px; Figma 3291:18896, 402 wide): the card is 370 x 640 (the frame has 720; Vansh, 2026-11-07)
       with the guides 23px in, and what is in it scrolls as one: nothing is stuck to the top. The
       title, summary, the row of tags and chips (open, github) and the media pass under the same
       frosted bands as on a desktop (the 23px margins at the top and bottom). The title does not
       scroll away: as you scroll it shrinks and moves up into the top band, between the expand and
       close corners (src/pages/[slug].astro's script sets --p, 0 at rest to 1). The previous / next
       chevrons are at the end of the post. The corners are 20px with the 12px glyph centred in
       them; the first media block is 322 x 385, the gallery under it, 24px apart */
    @media (max-width: 899px) {
        .post {
            height: min(720px, 90dvh);
            max-height: none;
            overflow: hidden;
        }
        :global(.overlay.full) .post {
            height: 100dvh;
        }
        /* Both side guides are right against the content's edges, one pixel outside them */
        .post::after {
            left: calc(var(--frame) - 1px);
            right: calc(var(--frame) - 1px);
        }
        .band {
            left: var(--frame);
        }
        /* The scroller: the whole card, padded by the frame so that at rest it starts on the
           guides, and what scrolls passes under the bands. Its lines are one flex container */
        .inner,
        :global(.overlay.full) .inner {
            position: absolute;
            inset: 0;
            margin: 0;
            /* No padding above or below: browsers differ on whether a sticky offset counts from
               inside it, so the top and bottom margins are the first and last lines' own */
            padding: 0 var(--frame);
            display: flex;
            flex-wrap: wrap;
            align-content: flex-start;
            align-items: center;
            gap: 16px 12px;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: none;
        }
        .inner::-webkit-scrollbar {
            display: none;
        }
        /* The room under the last line (the row gap adds to it) */
        .inner::after {
            content: "";
            flex: 0 0 100%;
            height: calc(var(--frame) - 16px);
        }
        /* The text blocks and the chips are the scroller's own lines */
        .info,
        .title {
            display: contents;
        }
        h1 {
            flex: 0 0 100%;
            margin-top: var(--frame);
            /* Gives way to the title in the strip as the card scrolls (--p, on the card, 0 to 1) */
            opacity: calc(1 - min(1, var(--p, 0) * 4));
        }
        /* The title in the strip, not part of what scrolls (so dragging the content, even past its
           end, cannot take it along): it starts exactly over the title and, as --p goes from 0 to 1,
           shrinks to 60% and moves up to the middle of the top strip, between the corners */
        .mini {
            display: block;
            position: absolute;
            z-index: 3;
            left: var(--frame);
            top: var(--frame);
            max-width: calc(100% - 2 * var(--frame));
            font-size: 24px;
            line-height: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            pointer-events: none;
            opacity: min(1, calc(var(--p, 0) * 4));
            transform-origin: 50% 50%;
            transform: translate(calc(var(--dx, 0px) * var(--p, 0)), calc(var(--dy, 0px) * var(--p, 0))) scale(calc(1 - 0.4 * var(--p, 0)));
        }
        .summary {
            flex: 0 0 100%;
        }
        .tags {
            flex: 1 1 0;
            min-width: 0;
            padding-top: 12px;
        }
        .links {
            flex: none;
            flex-wrap: nowrap;
            margin: 0;
            padding-top: 12px;
        }
        /* The chevrons last in the row: open, github, previous, next */
        .links .chip.step {
            order: 1;
        }
        .media {
            flex: 0 0 100%;
            margin: 8px 0 0;
            padding: 0;
            overflow: visible;
        }
        .media :global(.stage),
        .media > :global(img:first-child),
        .media > .fill:first-child {
            aspect-ratio: 11 / 7;
        }
        /* A post that scrolls has them again at its end (the script below sets data-scrolls) */
        .steps {
            flex: 0 0 100%;
            justify-content: center;
            gap: 12px;
            margin-top: 12px;
        }
        .post[data-scrolls] .steps {
            display: flex;
        }
        /* The frosted bands over the top and bottom margins, as on a desktop */
        .band {
            display: block;
        }
    }
    /* A phone (Figma 3291:18896, 402 wide): the card is 370 x 640 (the frame has 720; Vansh,
       2026-11-07) with the guides 23px in, its own type sizes and spacing, and the first media block
       322 x 385. The scrolling itself (above) is shared with a tablet held upright, which keeps the
       desktop's spacing */
    @media (max-width: 599px) {
        .post {
            --frame: 23px;
            height: min(640px, calc(100dvh - 96px));
        }
        .inner,
        :global(.overlay.full) .inner {
            gap: 12px 8px;
        }
        .inner::after {
            height: calc(var(--frame) - 12px);
        }
        .corner {
            top: 1px;
            width: 20px;
            height: 20px;
        }
        .corner .icon {
            width: 12px;
            height: 12px;
        }
        .expand {
            left: 1px;
        }
        .back {
            right: 1px;
        }
        h1,
        .mini {
            font-size: 20px;
        }
        .summary {
            font-size: 12px;
            line-height: 1;
        }
        .tags {
            font-size: 11px;
        }
        .chip {
            font-size: 12px;
        }
        .icon.prev,
        .icon.next {
            width: 12px;
            height: 12px;
        }
        .media {
            margin-top: 12px;
        }
        .media :global(.stage),
        .media > :global(img:first-child),
        .media > .fill:first-child {
            aspect-ratio: 322 / 385;
        }
    }
</style>

<script>
    // On a phone the title shrinks and moves up into the strip at the top of the card as the card
    // scrolls (see the phone rules above): this keeps --p (0 at rest to 1 after about 56px) on the
    // card, and --dx and --dy (how far the title in the strip, which starts over the real one, has
    // to go to sit in the middle of the strip). It also marks a card that scrolls (data-scrolls on
    // the card, which shows the chevrons at the end too). Bound to every card there is, again
    // after a switch
    const phone = matchMedia("(max-width: 899px)")
    function bind(inner: HTMLElement) {
        if (inner.dataset.collapse !== undefined) return
        inner.dataset.collapse = ""
        const post = inner.closest<HTMLElement>(".post")
        const media = inner.querySelector<HTMLElement>(".media")
        const mini = post?.querySelector<HTMLElement>(".mini")
        if (!post || !mini) return
        const measure = () => {
            const frame = parseFloat(getComputedStyle(post).getPropertyValue("--frame")) || 23
            // From its place over the title (the frame in from the left and the top) to the middle
            // of the card, in the middle of the strip above the top guide
            post.style.setProperty("--dx", `${inner.clientWidth / 2 - (frame + mini.offsetWidth / 2)}px`)
            post.style.setProperty("--dy", `${frame / 2 - (frame + mini.offsetHeight / 2)}px`)
        }
        const update = () => post.style.setProperty("--p", phone.matches ? String(Math.min(1, Math.max(0, inner.scrollTop / 56))) : "0")
        // Taller than the card without the chevrons at the end (or they would make it so)
        const scrolls = () => {
            const frame = parseFloat(getComputedStyle(post).getPropertyValue("--frame")) || 23
            post.toggleAttribute("data-scrolls", !!media && phone.matches && media.offsetTop + media.offsetHeight + frame > inner.clientHeight + 1)
        }
        inner.addEventListener("scroll", update, { passive: true })
        const watch = new ResizeObserver(() => {
            measure()
            update()
            scrolls()
        })
        watch.observe(inner)
        if (media) watch.observe(media)
        measure()
        update()
        scrolls()
    }
    const init = () => document.querySelectorAll<HTMLElement>(".post .inner").forEach(bind)
    init()
    document.addEventListener("overlay:open", init)
    document.addEventListener("nav:enter", init)
</script>

<script>
    // Gallery videos play by themselves while they are on screen, with sound; the only control is
    // the mute icon button in the top right. A browser that refuses sound before a click on the page (a post opened as a
    // page, not clicked open) plays it muted and the icon then shows muted. Reduced motion: no
    // autoplay (the video stays a still frame)
    const still = matchMedia("(prefers-reduced-motion: reduce)")
    function clip(box: HTMLElement) {
        if (box.dataset.clip !== undefined) return
        box.dataset.clip = ""
        const v = box.querySelector("video")
        const b = box.querySelector<HTMLButtonElement>(".mute")
        if (!v || !b) return
        let muted = false
        let seen = false
        const show = () => {
            v.muted = muted
            b.setAttribute("aria-label", muted ? "Unmute" : "Mute")
            b.setAttribute("aria-pressed", String(muted))
        }
        const play = () => {
            if (still.matches) return
            v.muted = muted
            v.play().catch(() => {
                muted = true
                show()
                v.play().catch(() => {})
            })
        }
        b.addEventListener("click", () => {
            muted = !muted
            show()
        })
        const io = new IntersectionObserver(([e]) => {
            seen = e.isIntersecting
            if (seen && !document.hidden) play()
            else v.pause()
        }, { threshold: 0.4 })
        io.observe(box)
        const hide = () => {
            if (!box.isConnected) return document.removeEventListener("visibilitychange", hide)
            if (document.hidden) v.pause()
            else if (seen) play()
        }
        document.addEventListener("visibilitychange", hide)
    }
    const init = () => document.querySelectorAll<HTMLElement>(".post .clip").forEach(clip)
    init()
    document.addEventListener("overlay:open", init)
    document.addEventListener("nav:enter", init)
</script>
