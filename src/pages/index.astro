---
import Base from "../layouts/Base.astro"
import Grid from "../components/Grid.astro"
import { getEntries } from "../lib/entries"

const items = await getEntries()
---

<Base>
    <main class="wrap" data-barba="container" data-barba-namespace="home">
        <section class="intro" data-burst>
            <div class="box">
                <h1>ART/FACTS</h1>
                <p>These are the experiments I built over time learning tools, workflows, tricks.</p>
            </div>
        </section>
        <Grid items={items} />
    </main>
</Base>

<script>
    // The intro effect is not needed before the page scrolls, so it loads once the page is
    // idle (or on the first scroll, if that comes sooner) and stays out of the first load.
    // While the loading animation plays (splash.ts) the idle load waits for it to end, so
    // sampling the text cannot stall it
    const load = () => import("../lib/intro")
    const idle = () => ("requestIdleCallback" in window ? requestIdleCallback(load, { timeout: 1500 }) : setTimeout(load, 200))
    if (document.documentElement.hasAttribute("data-splash")) document.addEventListener("splash:done", idle, { once: true })
    else idle()
    addEventListener("scroll", load, { once: true, passive: true })
    // The tuning panel for the particles, only under `npm run dev`
    if (import.meta.env.DEV) import("../lib/tune")
</script>

<style>
    /* The heading and its line sit in a hairline box in the middle of the page (Figma frame
       3203:17832), with 240px at 1440 wide above it (under the 56px logo header) and 240px
       below it before the grid (Vansh, 2026-10-31: 160px, then 240px; the frame has 120px and 117px) */
    .intro {
        position: relative;
        display: flex;
        justify-content: center;
        padding-top: clamp(64px, 16.667vw, 240px);
        margin-bottom: clamp(64px, 16.667vw, 240px);
    }
    /* The box's line fades with the real text while the particles stand in for it
       (--frame is set by src/lib/intro.ts) */
    .box {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 24px 80px;
        box-sizing: border-box;
        max-width: 100%;
        padding: 24px;
        border: 1px solid color-mix(in srgb, var(--gray-100) calc(var(--frame, 1) * 100%), transparent);
    }
    /* The particles the heading and line burst into (src/lib/intro.ts); they cover the window
       because after the burst they follow the pointer anywhere */
    .intro :global(.burst) {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
    }
    h1 {
        margin: 0;
        font-family: var(--pixel);
        font-weight: 400;
        font-size: 32px;
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--gray-main);
    }
    p {
        margin: 0;
        width: 254px;
        max-width: 100%;
        font-weight: 300;
        line-height: 1.3;
        text-align: justify;
        color: var(--gray-700);
    }
    /* A phone (Figma 3291:18544): 123px under the logo header and 120px below, the box 32px in from
       the window's edge and stacked and centred: the heading at 24px over the line at 14px */
    @media (max-width: 599px) {
        .intro {
            padding-top: 30.6vw;
            margin-bottom: 29.85vw;
        }
        .box {
            flex-direction: column;
            flex-wrap: nowrap;
            gap: 24px;
            width: calc(100% - 32px);
            padding: 24px 16px;
        }
        h1 {
            font-size: 24px;
        }
        p {
            width: 228px;
            font-size: 14px;
            text-align: center;
        }
    }
    /* Dark (Figma 3273:17727): Gray/500, not the turned-over Gray/700 */
    :global(html[data-theme="dark"]) p {
        color: var(--gray-500);
    }
</style>
