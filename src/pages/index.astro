---
import Base from "../layouts/Base.astro"
import Grid from "../components/Grid.astro"
import { getEntries } from "../lib/entries"

const items = await getEntries()
---

<Base>
    <main class="wrap">
        <section class="intro">
            <h1>ART/facts</h1>
            <p>These are the experiments I built over time learning tools, workflows, tricks.</p>
        </section>
        <Grid items={items} />
    </main>
</Base>

<style>
    .intro {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        padding-top: clamp(96px, 17.4vw, 250px);
        margin-bottom: clamp(48px, 12.6vw, 182px);
    }
    h1 {
        margin: 0;
        font-family: var(--pixel);
        font-weight: 400;
        font-size: clamp(36px, 3.333vw, 48px);
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--gray-500);
    }
    p {
        margin: 7px 0 0;
        width: 317px;
        max-width: 100%;
        font-weight: 300;
        line-height: 1.3;
        text-align: justify;
        color: var(--gray-500);
    }
</style>
