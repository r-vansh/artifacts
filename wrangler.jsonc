// Cloudflare Workers config: the site is plain static files in dist/, served from
// Cloudflare's edge with no server code. Having this file stops `wrangler deploy`
// from trying to add a server adapter.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifacts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
